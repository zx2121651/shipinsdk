<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Effects Button -->
    <LinearLayout
        android:id="@+id/btn_effects"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_record"
        app:layout_constraintTop_toTopOf="@id/btn_record"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_effects" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Effects"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main Record Button -->
    <ImageButton
        android:id="@+id/btn_record"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_record_btn_idle"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3" />

    <!-- Gallery/Upload Button -->
    <LinearLayout
        android:id="@+id/btn_gallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_record"
        app:layout_constraintTop_toTopOf="@id/btn_record"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_gallery" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Upload"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Mode Selector -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15s" android:textColor="#88FFFFFF" android:layout_marginEnd="24dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60s" android:textColor="#88FFFFFF" android:layout_marginEnd="24dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Video" android:textColor="#FFFFFF" android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
